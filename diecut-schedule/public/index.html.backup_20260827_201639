              <div class="modal-body">
                <div class="mb-3"><label class="form-label">用户名 *</label><input class="form-control" id="newUsername"></div>
                <div class="mb-3"><label class="form-label">密码 *</label><input type="password" class="form-control" id="newUserPassword"></div>
                <div class="mb-3"><label class="form-label">角色</label>
                  <select class="form-select" id="newUserRole">
                    <option value="viewer">查看者</option>
                    <option value="editor">编辑者</option>
                    <option value="admin">管理员</option>
                  </select>
                </div>
              </div>
              <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" onclick="saveUser()">保存</button></div>
            </div></div>
          </div>`;
        $('#usersTable').DataTable({destroy: true});
        hideLoading();
      });
    }

    function showUserModal() {
      document.getElementById('newUsername').value = '';
      document.getElementById('newUserPassword').value = '';
      document.getElementById('newUserRole').value = 'viewer';
      new bootstrap.Modal(document.getElementById('userModal')).show();
    }

    async function saveUser() {
      const username = document.getElementById('newUsername').value.trim();
      const password = document.getElementById('newUserPassword').value;
      const role = document.getElementById('newUserRole').value;
      if (!username || !password) { showToast('用户名和密码不能为空', 'warning'); return; }
      try {
        const resp = await fetch('/api/users', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, role })
        });
        const data = await resp.json();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('userModal')).hide();
          showToast('用户创建成功', 'success');
          loadUsers();
        } else showToast(data.message || '创建失败', 'danger');
      } catch (e) { showToast('网络错误', 'danger'); }
    }

    async function deleteUser(id) {
      if (!confirm('确认删除该用户？')) return;
      try {
        const resp = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        const data = await resp.json();
        if (data.success) { showToast('用户已删除', 'success'); loadUsers(); }
        else showToast(data.message || '删除失败', 'danger');
      } catch (e) { showToast('网络错误', 'danger'); }
    }

    // ========== 系统设置 ==========
    function loadSettings() {
      fetch('/api/settings').then(r => r.json()).then(d => {
        workSettings = d.settings || {};
        const s = workSettings;
        document.getElementById('contentArea').innerHTML = `
          <div class="card-custom">
            <div class="card-header">系统设置</div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-4 mb-3"><label class="form-label">上班时间</label><input type="time" class="form-control" id="workStart" value="${s.work_start || '08:00'}"></div>
                <div class="col-md-4 mb-3"><label class="form-label">下班时间</label><input type="time" class="form-control" id="workEnd" value="${s.work_end || '20:00'}"></div>
                <div class="col-md-4 mb-3"><label class="form-label">午餐开始</label><input type="time" class="form-control" id="lunchStart" value="${s.break_lunch_start || '12:00'}"></div>
                <div class="col-md-4 mb-3"><label class="form-label">午餐结束</label><input type="time" class="form-control" id="lunchEnd" value="${s.break_lunch_end || '13:00'}"></div>
                <div class="col-md-4 mb-3"><label class="form-label">晚餐开始</label><input type="time" class="form-control" id="dinnerStart" value="${s.break_dinner_start || '17:30'}"></div>
                <div class="col-md-4 mb-3"><label class="form-label">晚餐结束</label><input type="time" class="form-control" id="dinnerEnd" value="${s.break_dinner_end || '18:00'}"></div>
              </div>
            </div>
            <div class="card-footer text-end">
              ${currentUser.role !== 'viewer' ? '<button class="btn btn-primary" onclick="saveSettings()">保存设置</button>' : ''}
            </div>
          </div>
          <div class="card-custom">
            <div class="card-header">APS 高级排程规则 <span class="small text-muted">刀模/产品族换型时间矩阵</span></div>
            <div class="card-body">
              <p class="small text-muted">系统默认使用订单换模时间；在这里配置特定“上一刀模 → 下一刀模”的实际换模时间，可进一步减少估算误差。</p>
              ${currentUser.role !== 'viewer' ? `
              <div class="row g-2 mb-3">
                <div class="col-md-4"><input class="form-control" id="setupFrom" placeholder="例如 MOLD:A001"></div>
                <div class="col-md-4"><input class="form-control" id="setupTo" placeholder="例如 MOLD:B002"></div>
                <div class="col-md-2"><input type="number" min="0" class="form-control" id="setupMinutes" value="30"></div>
                <div class="col-md-2"><button class="btn btn-outline-primary w-100" onclick="saveSetupRule()">保存规则</button></div>
              </div>` : ''}
              <div class="table-responsive"><table class="table table-sm" id="setupRulesTable"><thead><tr><th>上一族</th><th>下一族</th><th>换模分钟</th><th>操作</th></tr></thead><tbody id="setupRulesBody"><tr><td colspan="4" class="text-muted">加载中...</td></tr></tbody></table></div>
            </div>
          </div>`;
        loadSetupRules();
        hideLoading();
      });
    }

    async function loadSetupRules() {
      try {
        const resp = await fetch('/api/setup-rules');
        const data = await resp.json();
        const body = document.getElementById('setupRulesBody');
        if (!body) return;
        const rules = data.rules || [];
        body.innerHTML = rules.length ? rules.map(r => `<tr><td>${escapeHtml(r.from_family)}</td><td>${escapeHtml(r.to_family)}</td><td>${Number(r.minutes)||0}</td><td>${currentUser.role!=='viewer'?`<button class="btn btn-sm btn-outline-danger" onclick="deleteSetupRule(${Number(r.id)})">删除</button>`:'-'}</td></tr>`).join('') : '<tr><td colspan="4" class="text-muted">暂无特殊换模规则，系统使用默认换模时间</td></tr>';
      } catch (e) {
        const body = document.getElementById('setupRulesBody');
        if (body) body.innerHTML = '<tr><td colspan="4" class="text-danger">加载规则失败</td></tr>';
      }
    }

    async function saveSetupRule() {
      const from_family = document.getElementById('setupFrom').value.trim();
      const to_family = document.getElementById('setupTo').value.trim();
      const minutes = parseInt(document.getElementById('setupMinutes').value) || 0;
      if (!from_family || !to_family) { showToast('请填写上一族和下一族', 'warning'); return; }
      const resp = await fetch('/api/setup-rules', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({from_family,to_family,minutes}) });
      const data = await resp.json();
      if (data.success) { showToast('换模规则已保存', 'success'); loadSetupRules(); } else showToast(data.message || '保存失败','danger');
    }

    async function deleteSetupRule(id) {
      if (!confirm('确认删除这条换模规则？')) return;
      const resp = await fetch(`/api/setup-rules/${id}`, { method:'DELETE' });
      const data = await resp.json();
      if (data.success) { showToast('规则已删除','success'); loadSetupRules(); } else showToast(data.message || '删除失败','danger');
    }

    async function saveSettings() {
      const payload = {
        work_start: document.getElementById('workStart').value,
        work_end: document.getElementById('workEnd').value,
        break_lunch_start: document.getElementById('lunchStart').value,
        break_lunch_end: document.getElementById('lunchEnd').value,
        break_dinner_start: document.getElementById('dinnerStart').value,
        break_dinner_end: document.getElementById('dinnerEnd').value
      };
      try {
        const resp = await fetch('/api/settings', {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await resp.json();
        if (data.success) showToast('设置已保存', 'success');
        else showToast(data.message || '保存失败', 'danger');
      } catch (e) { showToast('网络错误', 'danger'); }
    }

    // ========== 修改密码 ==========
    function openChangePassword() {
      document.getElementById('oldPassword').value = '';
      document.getElementById('newPassword').value = '';
      document.getElementById('pwdError').textContent = '';
      new bootstrap.Modal(document.getElementById('changePwdModal')).show();
    }

    async function changePassword() {
      const oldPassword = document.getElementById('oldPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      if (!oldPassword || !newPassword) { document.getElementById('pwdError').textContent = '请输入完整'; return; }
      try {
        const resp = await fetch('/api/auth/change-password', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ oldPassword, newPassword })
        });
        const data = await resp.json();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('changePwdModal')).hide();
          showToast('密码修改成功', 'success');
        } else document.getElementById('pwdError').textContent = data.message || '修改失败';
      } catch (e) { document.getElementById('pwdError').textContent = '网络错误'; }
    }

    async function healthCheck() {
      try {
        const data = await apiJson('/api/health');
        showToast(data.ok ? '系统运行正常，数据库连接正常' : '系统健康检查异常', data.ok ? 'success' : 'warning');
      } catch (e) {
        showToast(e.message || '健康检查失败', 'danger');
      }
    }

    // ========== AI 助手 ==========
    function openAIAssistant() {
      document.getElementById('aiChatHistory').innerHTML = '';
      document.getElementById('aiQuestion').value = '';
      new bootstrap.Modal(document.getElementById('aiModal')).show();
    }

    async function askAI() {
      const question = document.getElementById('aiQuestion').value.trim();
      if (!question) return;
      const history = document.getElementById('aiChatHistory');
      history.innerHTML += `<div class="ai-msg user">${escapeHtml(question)}</div>`;
      document.getElementById('aiQuestion').value = '';

      let answer = '抱歉，我暂时无法理解该指令。您可以尝试输入工单编号+完工，例如：WO2024001 完工。';
      const match = question.match(/([A-Za-z0-9_-]+)\s*完工/);
      if (match) {
        const orderNumber = match[1];
        const order = allOrders.find(o => o.order_number === orderNumber);
        if (order) {
          const schedule = allSchedules.find(s => s.order_id === order.id && s.status !== 'completed');
          if (schedule) answer = `已找到工单 ${orderNumber}，对应排程 ID ${schedule.id}，请点击排产看板中的完工按钮进行操作。`;
          else answer = `工单 ${orderNumber} 尚未排产或已完工。`;
        } else answer = `未找到工单编号 ${orderNumber}。`;
      }
      history.innerHTML += `<div class="ai-msg bot">${escapeHtml(answer)}</div>`;
      history.scrollTop = history.scrollHeight;
    }
  
</script>
</body>
</html>