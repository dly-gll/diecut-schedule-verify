    async function loadWorkflowData(stage='shortage'){
      try{
        currentWorkflowStage=stage;
        const [b,k]=await Promise.all([
          fetch(`/api/workflow/board?stage=${encodeURIComponent(stage)}`).then(r=>r.json()),
          fetch('/api/workflow/kpi').then(r=>r.json())
        ]);
        workflowBoardData=b; workflowKpiData=k;
        if(['shortage','available_to_issue','waiting_schedule','in_process'].includes(currentWorkflowStage)) renderWorkflowBoard(stage);
      }catch(e){ console.error(e); if(['shortage','available_to_issue','waiting_schedule','in_process'].includes(currentWorkflowStage)) showToast('四板块数据加载失败','danger'); }
    }
    function switchWorkflowStage(stage){ currentWorkflowStage=stage; currentSubTab='workflow'; updateScheduleSidebar(); loadWorkflowData(stage); }
    function workflowTabsHtml(){
      const tabs=[['gantt','甘特图'],['list','列表视图']];
      return `<div class="workflow-tabs">${tabs.map(([k,t])=>`<div class="workflow-tab ${currentSubTab===k?'active':''}" onclick="switchSubTab('${k}')">${t}</div>`).join('')}</div>`;
    }
    function renderWorkflowBoard(stage){
      const c=document.getElementById('contentArea'); const b=workflowBoardData||{}; const kpi=(workflowKpiData?.kpi||[]).reduce((m,x)=>(m[x.stage]=x,m),{});
      const cards=[['shortage','欠料'],['available_to_issue','有料待发'],['waiting_schedule','车间待排'],['in_process','车间在制']].map(([key,label])=>{const x=kpi[key]||{}; return `<div class="box"><div class="workflow-muted">${label}·昨日达成率</div><div class="rate">${Number.isFinite(Number(x.rate))?Number(x.rate).toFixed(1):'100.0'}%</div><div class="workflow-muted">实际 ${x.actual_count||0} / 应完成 ${x.expected_count||0} ${Number(x.alert_count||0)>0?`· <span class="text-danger">预警 ${x.alert_count}</span>`:''}</div></div>`}).join('');
      // 欠料板块严格只展示工单级欠料信息，不展示品号级“出货欠数/库存/待检/销货/交货”汇总。
      const rows=(b.rows||[]).map(r=>`<tr>
        <td>${escapeHtml(r.order_number||'-')}</td><td>${escapeHtml(r.product_code||'-')}</td><td>${escapeHtml(r.product_name||'-')}</td><td>${Number(r.quantity||0)}</td>
        <td>${formatWorkflowDate(r.shipping_required_date||r.delivery_date)}</td><td>${formatWorkflowDate(r.workflow_expected_date)}</td>
        <td>${escapeHtml(r.order_status==='scheduled' ? '已排待制' : (r.workflow_production_progress||'-'))}</td><td>${escapeHtml(r.workflow_material_status||'-')}</td><td>${escapeHtml(r.workflow_shortage_detail||'-')}</td>
        <td>${r.scheduled_start?formatTime(r.scheduled_start):'-'}</td><td>${r.scheduled_end?formatTime(r.scheduled_end):'-'}</td></tr>`).join('');
      const tableHead=`<tr><th>工单</th><th>品号</th><th>品名</th><th>数量</th><th>要求出货/交货日期</th><th>板块预计日期</th><th>生产进度</th><th>是否齐料</th><th>欠料明细</th><th>预计开工</th><th>预计完工</th></tr>`;
      const alerts=(b.alerts||[]).map(a=>`<div class="workflow-alert"><strong>⚠ ${escapeHtml(a.order_number||a.product_code||'')}</strong> ${escapeHtml(a.reason||'')}</div>`).join('');
      const importBtn=currentUser.role!=='viewer'?`<label class="btn btn-sm btn-primary"><input type="file" hidden accept=".xlsx,.xls,.csv" onchange="importWorkflowExcel(this)">导入Excel并自动识别</label>`:'';
      const latest=b.latest_import_date?`<span class="workflow-muted ms-2">当前批次：${escapeHtml(b.latest_import_date)}</span>`:'';
      const stageTitle = workflowStageLabel(stage);
      c.innerHTML=`<div class="card-custom"><div class="card-header d-flex justify-content-between align-items-center"><div class="d-flex align-items-center gap-2"><span class="fw-semibold">${escapeHtml(stageTitle)}</span>${workflowTabsHtml()}${latest}</div><div>${importBtn} ${currentUser.role!=='viewer'?`<button class="btn btn-sm btn-outline-success ms-1" onclick="runAutoSchedule()">对待排工单排程</button>`:''}</div></div><div class="card-body"><div class="workflow-kpi">${cards}</div>${alerts}<div class="table-responsive"><table class="table table-sm table-hover"><thead>${tableHead}</thead><tbody>${rows||'<tr><td colspan="11" class="text-muted">当前批次该板块暂无数据</td></tr>'}</tbody></table></div></div></div>`;
    }
    async function importWorkflowExcel(input){
      const file=input.files?.[0]; if(!file)return;
      try{
        showLoading();
        const data=await file.arrayBuffer(); const wb=XLSX.read(data,{type:'array',cellDates:true}); let all=[];
        for(const sheetName of wb.SheetNames){
          const ws=wb.Sheets[sheetName];
          const matrix=XLSX.utils.sheet_to_json(ws,{header:1,defval:'',raw:true});
          let headerRow=0,bestScore=-1;
          for(let r=0;r<Math.min(matrix.length,15);r++){
            const vals=matrix[r].map(v=>String(v??'').trim());
            const score=vals.filter(v=>/品号|工单|销货数量|库存|待检|出货欠数|预计开工|是否齐料|生产进度|欠料明细|要求出货时间|刀模号|工艺/i.test(v)).length;
            if(score>bestScore){bestScore=score;headerRow=r;}
          }
          const rows=XLSX.utils.sheet_to_json(ws,{defval:'',raw:true,range:headerRow});
          rows.forEach((r,idx)=>{r.__sheet_name=sheetName;r.__row_index=headerRow+idx+2;all.push(r);});
        }
        if(!all.length) throw new Error('Excel没有数据');
        const resp=await apiJson('/api/workflow/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:file.name,rows:all,snapshot_date:new Date().toISOString().slice(0,10)})});
        if(!resp.success) throw new Error(resp.message||'导入失败');
        showToast(resp.message||'四板块Excel导入成功','success');
        workflowBoardData=null;
        await loadWorkflowData(currentWorkflowStage||'shortage');
        showToast(`当前批次：欠料 ${resp.stages?.shortage||0}，有料待发 ${resp.stages?.available_to_issue||0}，车间待排 ${resp.stages?.waiting_schedule||0}，车间在制 ${resp.stages?.in_process||0}`, 'info');
      }catch(e){console.error(e);showToast(e.message||'Excel导入失败','danger');}finally{hideLoading(); input.value='';}
    }
    function renderScheduleView() {
      if (['shortage','available_to_issue','waiting_schedule','in_process'].includes(currentWorkflowStage) && currentSubTab === 'workflow') renderWorkflowBoard(currentWorkflowStage);
      else if (currentSubTab === 'gantt') { currentWorkflowStage=null; renderGantt(); }
      else { currentWorkflowStage=null; renderScheduleDetail(); }
    }

    function formatTime(isoStr) {
      if (!isoStr) return '-';
      const d = new Date(isoStr);
      return d.toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    function formatWorkflowDate(value) {
      if (!value) return '-';
      const raw=String(value);
      const m=raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
      if(m) return `${m[1]}-${String(m[2]).padStart(2,'0')}-${String(m[3]).padStart(2,'0')}`;
      return raw.length>=10 ? raw.slice(0,10) : raw;
    }

    function toLocalInputValue(isoStr) {
      if (!isoStr) return '';
      const d = new Date(isoStr);
      const offset = d.getTimezoneOffset() * 60000;
      const local = new Date(d.getTime() - offset);
      return local.toISOString().slice(0, 16);
    }

    function renderGantt() {
      const container = document.getElementById('contentArea');
      if (!allSchedules.length) {
        container.innerHTML = `<div class="card-custom"><div class="card-header">排产甘特图</div><div class="card-body text-center py-5">暂无排程数据，请先执行自动排程</div></div>`;
        return;
      }

      let minTime = null, maxTime = null;
      allSchedules.forEach(s => {
        const start = new Date(s.mold_change_start || s.start_time);
        const end = new Date(s.end_time || s.start_time);
        if (!minTime || start < minTime) minTime = start;
        if (!maxTime || end > maxTime) maxTime = end;
      });
      if (!minTime) minTime = new Date();
      if (!maxTime) maxTime = new Date(minTime.getTime() + 86400000);

      const axisStart = new Date(minTime);
      axisStart.setHours(0, 0, 0, 0);
      const axisEnd = new Date(maxTime);
      axisEnd.setHours(23, 59, 59, 999);
      const totalMinutes = (axisEnd - axisStart) / 60000;
      const pxPerMinute = ganttDayWidth / (24 * 60);

      let tickIntervalMinutes;
      if (pxPerMinute >= 2) tickIntervalMinutes = 60;
      else if (pxPerMinute >= 1) tickIntervalMinutes = 120;
      else if (pxPerMinute >= 0.5) tickIntervalMinutes = 240;
      else tickIntervalMinutes = 480;

      let ticksHtml = '';
      const tickCount = Math.ceil(totalMinutes / tickIntervalMinutes);
      for (let i = 0; i <= tickCount; i++) {
        const minutesFromStart = i * tickIntervalMinutes;
        const left = minutesFromStart * pxPerMinute;
        const time = new Date(axisStart.getTime() + minutesFromStart * 60000);
        const timeStr = `${time.getMonth()+1}/${time.getDate()} ${time.getHours()}:00`;
        ticksHtml += `<div class="gantt-time-tick" style="left:${left}px;">${timeStr}</div>`;
      }

      const settings = workSettings;
      let breakZonesHtml = '';
      for (let d = 0; d <= Math.ceil(totalMinutes / (24*60)); d++) {
        const curDay = new Date(axisStart);
        curDay.setDate(curDay.getDate() + d);
        curDay.setHours(0,0,0,0);
        if (settings) {
          const lunchStart = new Date(curDay);
          const [lh, lm] = settings.break_lunch_start.split(':').map(Number);
          lunchStart.setHours(lh, lm, 0, 0);
          const lunchEnd = new Date(curDay);
          const [lh2, lm2] = settings.break_lunch_end.split(':').map(Number);
          lunchEnd.setHours(lh2, lm2, 0, 0);
          const dinnerStart = new Date(curDay);
          const [dh, dm] = settings.break_dinner_start.split(':').map(Number);
          dinnerStart.setHours(dh, dm, 0, 0);
          const dinnerEnd = new Date(curDay);
          const [dh2, dm2] = settings.break_dinner_end.split(':').map(Number);
          dinnerEnd.setHours(dh2, dm2, 0, 0);
          const leftLunch = (lunchStart - axisStart) / 60000 * pxPerMinute;
          const widthLunch = (lunchEnd - lunchStart) / 60000 * pxPerMinute;
          const leftDinner = (dinnerStart - axisStart) / 60000 * pxPerMinute;
          const widthDinner = (dinnerEnd - dinnerStart) / 60000 * pxPerMinute;
          breakZonesHtml += `<div class="break-zone" style="left:${leftLunch}px;width:${widthLunch}px;"></div>`;
          breakZonesHtml += `<div class="break-zone" style="left:${leftDinner}px;width:${widthDinner}px;"></div>`;
        }
      }

      const machines = allMachines.filter(m => m.status === 'active');
      let rowsHtml = '';
      machines.forEach(m => {
        const machineSchedules = allSchedules.filter(s => s.machine_id === m.id);
        rowsHtml += `<div class="gantt-row">
          <div class="gantt-label">${m.name}</div>
          <div class="gantt-track">`;
        machineSchedules.forEach(s => {
          const moldStart = new Date(s.mold_change_start);
          const moldEnd = new Date(s.mold_change_end);
          const prodStart = new Date(s.start_time);
          const prodEnd = new Date(s.end_time);
          const leftMold = (moldStart - axisStart) / 60000 * pxPerMinute;
          const widthMold = (moldEnd - moldStart) / 60000 * pxPerMinute;
          const leftProd = (prodStart - axisStart) / 60000 * pxPerMinute;
          const widthProd = (prodEnd - prodStart) / 60000 * pxPerMinute;
          const order = allOrders.find(o => o.id === s.order_id);
          const label = order ? `${order.order_number}` : s.id;
          rowsHtml += `
            <div class="gantt-bar mold" style="left:${leftMold}px;width:${widthMold}px;" title="换模 ${label}">换模</div>
            <div class="gantt-bar production ${s.status}" style="left:${leftProd}px;width:${widthProd}px;" 
                 onclick="openCompleteModal(${s.id})" title="${label} 生产">${label}</div>`;
        });
        rowsHtml += `</div></div>`;
      });

      container.innerHTML = `
        <div class="card-custom">
          <div class="card-header">${workflowTabsHtml()}
            <div class="sub-tab ${currentSubTab==='gantt'?'active':''}" onclick="switchSubTab('gantt')">甘特图</div>
            <div class="sub-tab ${currentSubTab==='list'?'active':''}" onclick="switchSubTab('list')">列表视图</div>
            <div class="zoom-container">
              <button class="btn btn-sm btn-outline-secondary" onclick="zoomGantt(-10)" title="缩小">-</button>
              <button class="btn btn-sm btn-outline-secondary" onclick="resetZoom()" title="重置缩放">重置</button>
              <button class="btn btn-sm btn-outline-secondary" onclick="zoomGantt(10)" title="放大">+</button>
            </div>
          </div>
          <div class="card-body gantt-container">
            <div class="gantt-time-axis" style="position:relative;">${ticksHtml}${breakZonesHtml}</div>
            ${rowsHtml}
          </div>
          <div class="card-footer d-flex justify-content-between">
            <span class="small text-muted">点击生产条可完工确认；已完工任务可“调整完工”，修改实际完工时间后，后续未开工任务会按新时间自动重排</span>
            <div>
              ${currentUser.role !== 'viewer' ? `
                <button class="btn btn-sm btn-outline-success" onclick="runAutoSchedule()">智能排程</button>
                <button class="btn btn-sm btn-outline-danger" onclick="clearSchedules()">清空排程</button>
                <button class="btn btn-sm btn-outline-primary" onclick="exportSchedules()">导出</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="showScheduleChanges()">变更历史</button>
              ` : ''}
            </div>
          </div>
        </div>`;
    }

    function zoomGantt(change) {
      ganttDayWidth = Math.max(20, Math.min(2000, ganttDayWidth + change));
      renderGantt();
    }

    function resetZoom() {
      ganttDayWidth = 100;
      renderGantt();
    }

    function renderScheduleDetail() {
      const container = document.getElementById('contentArea');
      let rows = '';
