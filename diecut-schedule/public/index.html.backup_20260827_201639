      container.innerHTML = `
        <div class="card-custom">
          <div class="card-header">${workflowTabsHtml()}
            <div class="sub-tab ${currentSubTab==='gantt'?'active':''}" onclick="switchSubTab('gantt')">甘特图</div>
            <div class="sub-tab ${currentSubTab==='list'?'active':''}" onclick="switchSubTab('list')">列表视图</div>
          </div>
          <div class="card-body table-responsive">
            <table class="table table-hover" id="scheduleTable">
              <thead class="table-light"><tr><th>工单编号</th><th>品号</th><th>品名</th><th>设备</th><th>换模开始</th><th>换模结束</th><th>生产开始</th><th>生产结束</th><th>计划数量</th><th>状态</th><th>完工时间</th><th>操作</th></tr></thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
          <div class="card-footer d-flex justify-content-end">
            ${currentUser.role !== 'viewer' ? `
              <button class="btn btn-sm btn-outline-success me-2" onclick="runAutoSchedule()">V5智能排程</button>
              <button class="btn btn-sm btn-outline-danger me-2" onclick="clearSchedules()">清空排程</button>
              <button class="btn btn-sm btn-outline-primary" onclick="exportSchedules()">导出</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="showScheduleChanges()">变更历史</button>
