    async function importOrders(input) {
      const file = input.files[0];
      if (!file) return;
      try {
        showLoading();
        const buffer = await file.arrayBuffer();
        const wb = XLSX.read(buffer, { type: 'array', cellDates: true });
        if (!wb.SheetNames.length) throw new Error('Excel 没有工作表');

        const isStandardProductionWorkbook =
          wb.SheetNames.some(n => /在制工单明细|生产工单明细/i.test(n)) &&
          wb.SheetNames.some(n => /刀模基表/i.test(n));

        if (isStandardProductionWorkbook) {
          // 这是 PMC 每日标准表：不要再把“销货明细”第一页误当成工单。
          const all = [];
          for (const sheetName of wb.SheetNames) {
            const ws = wb.Sheets[sheetName];
            const matrix = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '', raw: true });
            let headerRow = 0;
            let bestScore = -1;
            for (let r = 0; r < Math.min(matrix.length, 15); r++) {
              const vals = matrix[r].map(v => String(v ?? '').trim());
              const score = vals.filter(v => /品号|工单|销货数量|库存|待检|出货欠数|预计开工|是否齐料|刀模号|工艺/i.test(v)).length;
              if (score > bestScore) { bestScore = score; headerRow = r; }
            }
            const rows = XLSX.utils.sheet_to_json(ws, { defval: '', raw: true, range: headerRow });
            rows.forEach((r, idx) => { r.__sheet_name = sheetName; r.__row_index = headerRow + idx + 2; all.push(r); });
          }
          const resp = await apiJson('/api/workflow/import', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ filename:file.name, rows:all, snapshot_date:new Date().toISOString().slice(0,10) })
          });
          hideLoading();
          if (!resp.success) throw new Error(resp.message || '生产工作流导入失败');
          showToast(resp.message || '生产计划Excel已自动识别', 'success');
          currentSubTab='workflow';
          currentWorkflowStage='shortage';
          await loadWorkflowData(currentWorkflowStage);
          if ((resp.stages||{}).waiting_schedule>0) {
            showToast('检测到车间待排工单，正在按出货需求日期/交货日期 + 预计开工时间自动排程','info');
            setTimeout(()=>runAutoSchedule(),300);
          }
          return;
        }

        const sheet = wb.Sheets[wb.SheetNames[0]];
        const rows = XLSX.utils.sheet_to_json(sheet, { defval: '', raw:true });
        if (!rows.length) throw new Error('Excel 没有数据');

        // 先交给后端做 V5 智能字段映射：支持中文/英文/自定义列名，并自动反查产品主数据。
        const normalize = await apiJson('/api/orders/import-normalize', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ rows })
        });
        const orders = (normalize.orders || []).map(o => {
          const x = { ...o };
          delete x.__import_index;
          delete x.__matched_product;
          delete x.__missing;
          return x;
        });

        if (normalize.unresolved_count) {
          const sample = (normalize.unresolved || []).slice(0,8).map(x => `第${x.row}行${x.product_code || x.order_number || ''}缺${x.missing.join('、')}`).join('；');
          hideLoading();
          showToast(`有 ${normalize.unresolved_count} 条工单还无法自动匹配：${sample}`, 'warning');
          return;
        }

        // 大批量分块导入，避免一次请求过大；每 500 条提交一次。
        const chunkSize = 500;
        let imported = 0;
        for (let i=0; i<orders.length; i+=chunkSize) {
          const chunk = orders.slice(i, i+chunkSize);
          const result = await apiJson('/api/orders/batch-import', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ orders: chunk })
          });
          imported += Number(result.count || chunk.length);
        }

        hideLoading();
        showToast(`Excel 智能导入完成：${imported} 条。已自动匹配产品主数据 ${normalize.matched_product_count || 0} 条。`, 'success');
        loadOrders();
      } catch (err) {
        hideLoading();
        console.error('Excel 导入失败', err);
        showToast(err.message || 'Excel 导入失败', 'danger');
      } finally {
        input.value = '';
      }
    }

