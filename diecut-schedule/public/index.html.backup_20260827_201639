          <td>${statusBadge}</td>
          <td>${completedTime}</td>
          <td>${currentUser.role !== 'viewer' ? `${s.status === 'scheduled' ? `<button class="btn btn-sm btn-outline-primary me-1" onclick="startSchedule(${s.id})">开工</button>` : ''}${s.status !== 'completed' ? `<button class="btn btn-sm btn-outline-success" onclick="openCompleteModal(${s.id})">完工</button>` : `<button class="btn btn-sm btn-outline-warning" onclick="openCompleteModal(${s.id})">调整完工</button>`}` : '-'}</td>
