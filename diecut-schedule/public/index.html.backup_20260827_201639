    async function runAutoSchedule() {
      if(currentUser.role === 'viewer') { showToast('无操作权限', 'warning'); return; }
      if(!confirm('确认执行智能排程？系统会按交期、设备适配、刀模换模和设备负载重新计算未完工订单。')) return;
      showLoading();
      try {
        const pre = await apiJson('/api/schedule/precheck');
        if (!pre.ready) {
          hideLoading();
          showToast('排程预检未通过：' + pre.issues.join('；'), 'warning');
          return;
        }
        const data = await apiJson('/api/schedule/auto-run', { method:'POST' });
        hideLoading();

        if(data.success) {
          const lateText = Number(data.late_count || 0) > 0 ? `，预计延期 ${data.late_count} 单` : '，当前无预计延期订单';
          showToast(`V5智能排程完成：${data.schedule_count} 单${lateText}，换模 ${data.total_setup_minutes || 0} 分钟${data.urgent_count ? `，急单 ${data.urgent_count}` : ''}`, 'success');
          if (data.created_machines && data.created_machines.length) {
            showToast(`已自动补齐 ${data.created_machines.length} 台订单设备`, 'info');
          }
          if(data.unscheduled && data.unscheduled.length) {
            const sample = data.unscheduled.slice(0, 3).map(x => `${x.order_number || x.id}:${x.process || '未填写设备'}`).join('、');
            showToast(`仍有 ${data.unscheduled.length} 单未排：${sample}${data.unscheduled.length > 3 ? '……' : ''}`, 'warning');
          }
          navigateTo('schedule');
        } else {
          showToast(data.message || '排程失败', 'danger');
        }
      } catch(e) {
        hideLoading();
        showToast('网络错误，请检查服务器日志', 'danger');
      }
    }

    function getOrderPriorityInfo(order) {
      if (order?.shipping_required_date) return { level: '一级', label: '出货需求日期', date: order.shipping_required_date };
      if (order?.delivery_date || order?.delivery_time) return { level: '二级', label: '交货日期', date: order.delivery_date || order.delivery_time };
      return { level: '三级', label: '无日期后置', date: null };
    }
    function getEffectiveDue(order) {
      const info = getOrderPriorityInfo(order);
      return info.date ? new Date(info.date) : null;
    }

