    function openCompleteModal(scheduleId) {
      const schedule = allSchedules.find(s => s.id === scheduleId);
      if (!schedule) return;
      completeEditMode = schedule.status === 'completed';
      document.getElementById('completeScheduleId').value = schedule.id;
      document.getElementById('completeMoldStart').value = toLocalInputValue(schedule.mold_change_start);
      document.getElementById('completeMoldEnd').value = toLocalInputValue(schedule.mold_change_end);
      document.getElementById('completeStart').value = toLocalInputValue(schedule.start_time);
      document.getElementById('completeEnd').value = toLocalInputValue(schedule.end_time);
      document.getElementById('completeQuantity').value = schedule.planned_quantity;
      document.getElementById('completeModalTitle').textContent = completeEditMode ? '调整已完工记录' : '完工确认';
      document.getElementById('btnConfirmComplete').textContent = completeEditMode ? '保存调整并重排后续' : '确认完工';
      new bootstrap.Modal(document.getElementById('completeModal')).show();
    }

    async function startSchedule(id) {
      if (!confirm('确认将该任务标记为开工？开工后智能排程不会覆盖该任务。')) return;
      showLoading();
      try {
        const data = await apiJson(`/api/schedules/${id}/start`, { method:'POST' });
        hideLoading();
        showToast(data.message || '已开工', 'success');
        loadSchedule();
      } catch (e) {
        hideLoading();
        showToast(e.message || '开工失败', 'danger');
      }
    }

    async function confirmCompleteSchedule() {
      const id = document.getElementById('completeScheduleId').value;
      const payload = {
        mold_change_start: document.getElementById('completeMoldStart').value,
        mold_change_end: document.getElementById('completeMoldEnd').value,
        start_time: document.getElementById('completeStart').value,
        end_time: document.getElementById('completeEnd').value,
        planned_quantity: document.getElementById('completeQuantity').value
      };
      showLoading();
      try {
        const method = completeEditMode ? 'PUT' : 'POST';
        const data = await apiJson(`/api/schedules/${id}/complete`, {
          method, headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        hideLoading();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('completeModal')).hide();
          showToast(data.message || (completeEditMode ? '完工记录已调整' : '工单已完工'), 'success');
          completeEditMode = false;
          loadSchedule();
        } else showToast(data.message || '操作失败', 'danger');
      } catch (e) {
        hideLoading();
        showToast(e.message || '网络错误', 'danger');
      }
    }

    function clearSchedules() {
      if (!confirm('仅清空未开工排程。已开工和已完工任务会保留。确认继续？')) return;
      apiJson('/api/schedules/clear', { method: 'POST' })
        .then(d => { showToast(d.message || '排程已清空', 'success'); loadSchedule(); })
        .catch(e => showToast(e.message || '操作失败', 'danger'));
    }

    function exportSchedules() { window.location.href = '/api/schedules/export'; }

    async function showScheduleChanges() {
