    async function autoFillProduct() {
      const code = document.getElementById('productCode').value.trim();
      if (!code) return;
      try {
        const resp = await fetch(`/api/product-data/by-code/${encodeURIComponent(code)}`);
        const data = await resp.json();
        if (data.product) {
          const p = data.product;
          if (p.product_name) document.getElementById('productName').value = p.product_name;
          if (p.mold) document.getElementById('mold').value = p.mold;
          if (p.process) {
            const select = document.getElementById('process');
            if (![...select.options].some(opt => opt.value === p.process)) {
              select.add(new Option(p.process, p.process));
            }
            select.value = p.process;
          }
          if (p.capacity) document.getElementById('capacity').value = p.capacity;
          if (p.mold_change_time) document.getElementById('moldChangeTime').value = p.mold_change_time;
          showToast('已自动匹配产品数据', 'success');
        } else {
          showToast('未找到该品号的产品数据，请手动填写或到产品数据页添加', 'info');
        }
      } catch(e) { showToast('自动匹配失败', 'danger'); }
    }

    function showOrderModal(id) {
      document.getElementById('orderId').value = id || '';
      document.getElementById('orderModalTitle').textContent = id ? '编辑订单' : '新增订单';
      if(id) {
        const o = allOrders.find(o=>o.id===id);
        if(o) {
          document.getElementById('orderNumber').value=o.order_number||''; document.getElementById('productCode').value=o.product_code||'';
          document.getElementById('productName').value=o.product_name||''; document.getElementById('quantity').value=o.quantity;
          document.getElementById('shippingQuantity').value=o.shipping_quantity||0; document.getElementById('shippingRequiredDate').value=o.shipping_required_date?o.shipping_required_date.slice(0,10):''; document.getElementById('deliveryDate').value=o.delivery_date?o.delivery_date.slice(0,10):''; document.getElementById('deliveryTime').value=o.delivery_time?o.delivery_time.slice(0,10):'';
          document.getElementById('capacity').value=o.capacity||1000; document.getElementById('mold').value=o.mold||'';
          document.getElementById('moldChangeTime').value=o.mold_change_time||30;
          document.getElementById('priority').value=o.priority||0;
          document.getElementById('materialReadyAt').value=o.material_ready_at ? new Date(o.material_ready_at).toISOString().slice(0,16) : '';
          const select = document.getElementById('process');
          if (o.process && ![...select.options].some(opt => opt.value === o.process)) {
            select.add(new Option(o.process, o.process));
          }
          select.value = o.process || '';
        }
      } else {
        ['orderNumber','productCode','productName','mold'].forEach(id=>document.getElementById(id).value='');
        document.getElementById('quantity').value=1000; document.getElementById('shippingQuantity').value=0;
        document.getElementById('shippingRequiredDate').value=''; document.getElementById('deliveryDate').value=''; document.getElementById('deliveryTime').value=''; document.getElementById('capacity').value=1000;
        document.getElementById('moldChangeTime').value=30;
        document.getElementById('priority').value=0;
        document.getElementById('materialReadyAt').value='';
        const select = document.getElementById('process');
        if (select.options.length > 0) select.value = select.options[0].value;
      }
      new bootstrap.Modal(document.getElementById('orderModal')).show();
    }

    function editOrder(id) { showOrderModal(id); }

    async function saveOrder() {
      const id = document.getElementById('orderId').value;
      const payload = {
        order_number: document.getElementById('orderNumber').value.trim(),
        product_code: document.getElementById('productCode').value.trim(),
        product_name: document.getElementById('productName').value.trim(),
        quantity: parseInt(document.getElementById('quantity').value) || 0,
        shipping_quantity: parseInt(document.getElementById('shippingQuantity').value) || 0,
        shipping_required_date: document.getElementById('shippingRequiredDate').value,
        delivery_date: document.getElementById('deliveryDate').value,
        delivery_time: document.getElementById('deliveryTime').value,
        capacity: parseInt(document.getElementById('capacity').value) || 1000,
        mold: document.getElementById('mold').value.trim(),
        mold_change_time: parseInt(document.getElementById('moldChangeTime').value) || 30,
        process: document.getElementById('process').value,
        priority: Math.max(0, Math.min(100, parseInt(document.getElementById('priority').value) || 0)),
        material_ready_at: document.getElementById('materialReadyAt').value || null,
        remark: ''
      };
      if (!payload.order_number || !payload.product_code || !payload.product_name || !payload.mold) {
        showToast('请填写所有必填项', 'warning');
        return;
      }
      try {
        const url = id ? `/api/orders/${id}` : '/api/orders';
        const method = id ? 'PUT' : 'POST';
        const resp = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await resp.json();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('orderModal')).hide();
          showToast(id ? '订单已更新' : '订单已创建', 'success');
          loadOrders();
        } else {
          showToast(data.message || '保存失败', 'danger');
        }
      } catch (e) { showToast('网络错误', 'danger'); }
    }

    async function deleteOrder(id) {
      if (!confirm('确认删除该订单？')) return;
      try {
        const resp = await fetch(`/api/orders/${id}`, { method: 'DELETE' });
        const data = await resp.json();
        if (data.success) { showToast('订单已删除', 'success'); loadOrders(); }
        else showToast(data.message || '删除失败', 'danger');
      } catch (e) { showToast('网络错误', 'danger'); }
    }

    function toggleAllOrders(el) {
      document.querySelectorAll('.order-checkbox').forEach(cb => cb.checked = el.checked);
    }

    async function batchDeleteOrders() {
      const selected = [...document.querySelectorAll('.order-checkbox:checked')].map(cb => parseInt(cb.value));
      if (!selected.length) { showToast('请先选择要删除的订单', 'warning'); return; }
      if (!confirm(`确认删除选中的 ${selected.length} 条订单？`)) return;
      try {
        const resp = await fetch('/api/orders/batch-delete', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: selected })
        });
        const data = await resp.json();
        if (data.success) { showToast(`已删除 ${data.count} 条订单`, 'success'); loadOrders(); }
