From 387c45e255e9836a26b78d1e8f22948f02214b78 Mon Sep 17 00:00:00 2001
From: dly-gll <dly-gll@users.noreply.github.com>
Date: Thu, 27 Aug 2026 19:21:41 +0800
Subject: [PATCH] fix: security hardening and CI improvements

- Add production startup validation for SESSION_SECRET and DEFAULT_ADMIN_PASSWORD
- Remove insecure fallback values (admin123, diecut-schedule-secret-change-me)
- Add HSTS, X-XSS-Protection, X-Download-Options, X-DNS-Prefetch-Control headers
- Optimize CI: add Node.js 20 setup, npm cache, use npm ci
- Update CI test credentials to meet new validation requirements
- Add ESLint flat config with recommended rules
- Update .gitignore with more comprehensive patterns
- Remove tmp.txt from repository
---
 .github/workflows/v51-release-candidate.yml | 14 ++++--
 .gitignore                                  | 27 +++++++++++
 eslint.config.js                            | 51 +++++++++++++++++++++
 package.json                                | 10 +++-
 server.js                                   | 21 ++++++++-
 tmp.txt                                     |  1 -
 6 files changed, 115 insertions(+), 9 deletions(-)
 create mode 100644 eslint.config.js
 delete mode 100644 tmp.txt

diff --git a/.github/workflows/v51-release-candidate.yml b/.github/workflows/v51-release-candidate.yml
index 12a8721..586d0f2 100644
--- a/.github/workflows/v51-release-candidate.yml
+++ b/.github/workflows/v51-release-candidate.yml
@@ -19,6 +19,12 @@ jobs:
       - name: Checkout candidate branch
         uses: actions/checkout@v4
 
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+
       - name: Prepare candidate sources
         shell: bash
         run: |
@@ -44,7 +50,7 @@ jobs:
           echo 'd828aead93e9b43c7bfdc80bc4b9af6e900aaee69b4ad0ac4cef5a724a5f2e5a  public/index.html' | sha256sum -c -
 
       - name: Install dependencies
-        run: npm install --no-audit --no-fund
+        run: npm ci --no-audit --no-fund
 
       - name: Node syntax checks
         shell: bash
@@ -54,7 +60,7 @@ jobs:
           python3 - <<'PY'
           import re, pathlib, subprocess, sys
           html = pathlib.Path('public/index.html').read_text(encoding='utf-8')
-          blocks = re.findall(r'<script(?:\\s[^>]*)?>([\\s\\S]*?)</script>', html, flags=re.I)
+          blocks = re.findall(r'<script(?:\s[^>]*)?>([\s\S]*?)</script>', html, flags=re.I)
           print('script blocks:', len(blocks))
           if not blocks:
               raise SystemExit('No inline scripts found')
@@ -72,7 +78,7 @@ jobs:
         run: |
           set -euo pipefail
           rm -f data.db data.db-shm data.db-wal
-          PORT=3100 SESSION_SECRET=ci-test-secret DEFAULT_ADMIN_PASSWORD=admin123 node server.js > /tmp/diecut-server.log 2>&1 &
+          PORT=3100 SESSION_SECRET=ci-test-secret-must-be-at-least-32-chars DEFAULT_ADMIN_PASSWORD=admin123456 node server.js > /tmp/diecut-server.log 2>&1 &
           PID=$!
           trap 'kill $PID 2>/dev/null || true' EXIT
           for i in {1..30}; do
@@ -92,7 +98,7 @@ jobs:
           set -euo pipefail
           rm -f /tmp/cookies.txt
           curl -fsS -c /tmp/cookies.txt -H 'Content-Type: application/json' \
-            -d '{"username":"admin","password":"admin123"}' \
+            -d '{"username":"admin","password":"admin123456"}' \
             http://127.0.0.1:3100/api/auth/login > /tmp/login.json
           curl -fsS -b /tmp/cookies.txt http://127.0.0.1:3100/api/auth/status > /tmp/auth.json
           python3 - <<'PY'
